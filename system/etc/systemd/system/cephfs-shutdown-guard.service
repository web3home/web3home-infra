[Unit]
Description=Stop containers and unmount CephFS before network teardown
DefaultDependencies=no
After=network.target network-online.target docker.service
# Ceph must outlive the guard: at shutdown, units stop in reverse order, so
# these keep the OSD, mon, mds and the encrypted OSD disk up until containers
# have stopped and CephFS is unmounted.
After=snap.microceph.daemon.service snap.microceph.mon.service snap.microceph.mgr.service snap.microceph.mds.service snap.microceph.osd.service
After=systemd-cryptsetup@ceph\x2dosd.service
Before=shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
# The script acts only during a real shutdown/reboot, not a manual unit restart
ExecStop=/opt/web3home/bin/cephfs-shutdown-guard.sh
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
