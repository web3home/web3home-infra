[Unit]
Description=Restrict inbound 80/443 to Cloudflare edge + LAN (DOCKER-USER)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/web3home/bin/origin-lockdown.sh
ExecStop=/bin/bash -c 'while n=$(/sbin/iptables -S DOCKER-USER | grep -n -- "--comment origin-lockdown" | head -1 | cut -d: -f1); [ -n "$n" ]; do /sbin/iptables -D DOCKER-USER $((n-1)); done'

[Install]
WantedBy=multi-user.target
